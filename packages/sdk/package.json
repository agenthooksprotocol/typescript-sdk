{
  "name": "@agenthooksprotocol/sdk",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./draft": {
      "types": "./dist/src/draft/index.d.ts",
      "default": "./dist/src/draft/index.js"
    },
    "./generated": {
      "types": "./dist/src/generated.d.ts",
      "default": "./dist/src/generated.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "default": "./dist/src/client/index.js"
    },
    "./server": {
      "types": "./dist/src/server/index.d.ts",
      "default": "./dist/src/server/index.js"
    },
    "./server/stdio": {
      "types": "./dist/src/server/stdio.d.ts",
      "default": "./dist/src/server/stdio.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
