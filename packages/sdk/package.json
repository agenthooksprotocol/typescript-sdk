{
  "name": "agenthooksprotocol",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./draft": {
      "types": "./dist/src/draft/index.d.ts",
      "default": "./dist/src/draft/index.js"
    },
    "./generated": {
      "types": "./dist/src/generated.d.ts",
      "default": "./dist/src/generated.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "default": "./dist/src/client/index.js"
    },
    "./server": {
      "types": "./dist/src/server/index.d.ts",
      "default": "./dist/src/server/index.js"
    },
    "./server/stdio": {
      "types": "./dist/src/server/stdio.d.ts",
      "default": "./dist/src/server/stdio.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "description": "TypeScript SDK for the Agent Hooks Protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenthooksprotocol/typescript-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/agenthooksprotocol/typescript-sdk#readme",
  "bugs": {
    "url": "https://github.com/agenthooksprotocol/typescript-sdk/issues"
  },
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
